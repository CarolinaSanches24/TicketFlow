generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String
  role         Role          @default(ANALYST)
  tickets      Ticket[]
  improvements Improvement[]
  debts        Debt[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum Role {
  ADMIN
  ANALYST
}

model Ticket {
  id          String       @id @default(uuid())
  title       String
  description String
  status      TicketStatus @default(PENDING)
  analystId   String?
  analyst     User?        @relation(fields: [analystId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum TicketStatus {
  PENDING
  OPEN
  ON_HOLD
  FINISHED
}

model Improvement {
  id          String            @id @default(uuid())
  title       String
  description String
  status      ImprovementStatus @default(OPEN)
  analystId   String?
  analyst     User?             @relation(fields: [analystId], references: [id])
  debts       Debt[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum ImprovementStatus {
  OPEN
  IN_PROGRESS
  IN_TEST
  FINISHED
  CONVERTED_TO_DEBT
}

model Debt {
  id            String      @id @default(uuid())
  originType    OriginType
  originId      String
  improvement   Improvement @relation(fields: [originId], references: [id])
  description   String
  status        DebtStatus  @default(OPEN)
  analystId     String?
  analyst       User?       @relation(fields: [analystId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum OriginType {
  TICKET
  IMPROVEMENT
}

enum DebtStatus {
  OPEN
  IN_CORRECTION
  RESOLVED
}
